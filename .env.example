# Copy to .env and fill in. Never commit .env: it holds credentials.

# Which Podium to talk to. Required: the examples have no default.
#   Staging:    https://api.staging.podium.live
#   Production: https://api.podium.live
PODIUM_API_BASE=

# examples/api_key: an API key from Settings > API keys.
PODIUM_API_KEY=

# examples/oauth_cli: a *public* application from Settings > OAuth applications,
# with the redirect URI http://127.0.0.1:8765/callback.
PODIUM_PUBLIC_CLIENT_ID=

# examples/oauth_web: a *confidential* application, with the redirect URI
# http://127.0.0.1:5000/callback.
PODIUM_WEB_CLIENT_ID=
PODIUM_WEB_CLIENT_SECRET=

# examples/claude_api: an Anthropic API key (or run `ant auth login` instead).
ANTHROPIC_API_KEY=
